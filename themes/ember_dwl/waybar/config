{
    "layer": "top",
    "position": "top",
    "height": 32,
    "modules-left": [
        "wlr/taskbar"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "disk",
        "pulseaudio",
        "network",
        "battery"
    ],
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip-format": "{title}"
    },
    "clock": {
        "format": "{:%H:%M}"
    },
    "cpu": {
        "format": "\uf2db  {usage}%",
        "tooltip": true,
        "interval": 2
    },
    "memory": {
        "format": "\uf538  {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB",
        "interval": 2
    },
    "disk": {
        "format": "\uf0a0  {percentage_used}%",
        "path": "/",
        "tooltip-format": "{used} used / {total} ({percentage_used}%)",
        "interval": 30
    },
    "battery": {
        "format": "{icon}  {capacity}%",
        "format-charging": "\uf0e7  {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "network": {
        "format-wifi": "\uf1eb  {essid}",
        "format-ethernet": "\uf796  {ipaddr}",
        "format-disconnected": "\uf6ab  disconnected"
    },
    "pulseaudio": {
        "format": "\uf028  {volume}%",
        "format-muted": "\uf6a9  muted",
        "on-click": "pavucontrol"
    }
}
