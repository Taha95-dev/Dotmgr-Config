{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch3",
    "color": {
      "1": "light_black"
    }
  },
  "display": {
    "color": {
      "title": "white",
      "keys": "light_black",
      "output": "white"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "white",
        "at": "light_black",
        "host": "white"
      }
    },
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    {
      "type": "custom",
      "key": "Theme",
      "format": "Dark Charcoal"
    }
  ]
}

